map $http_upgrade $dzdp_connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    server_name CHANGE_ME_WEB_HOST CHANGE_ME_ADMIN_HOST CHANGE_ME_MERCHANT_HOST CHANGE_ME_API_HOST;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name CHANGE_ME_WEB_HOST;

    ssl_certificate CHANGE_ME_CERTIFICATE_FULLCHAIN;
    ssl_certificate_key CHANGE_ME_CERTIFICATE_KEY;
    root /opt/dazhongdianping/current/web/dist;

    location = /health {
        default_type text/plain;
        return 200 "ok\n";
    }
    location /assets/ {
        try_files $uri =404;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }
    location / {
        try_files $uri $uri/ /index.html;
    }
}

server {
    listen 443 ssl http2;
    server_name CHANGE_ME_ADMIN_HOST;

    ssl_certificate CHANGE_ME_CERTIFICATE_FULLCHAIN;
    ssl_certificate_key CHANGE_ME_CERTIFICATE_KEY;
    root /opt/dazhongdianping/current/admin-web/dist;

    location = /health {
        default_type text/plain;
        return 200 "ok\n";
    }
    location /assets/ {
        try_files $uri =404;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }
    location / {
        try_files $uri $uri/ /index.html;
    }
}

server {
    listen 443 ssl http2;
    server_name CHANGE_ME_MERCHANT_HOST;

    ssl_certificate CHANGE_ME_CERTIFICATE_FULLCHAIN;
    ssl_certificate_key CHANGE_ME_CERTIFICATE_KEY;
    root /opt/dazhongdianping/current/merchant-web/dist;

    location = /health {
        default_type text/plain;
        return 200 "ok\n";
    }
    location /assets/ {
        try_files $uri =404;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }
    location / {
        try_files $uri $uri/ /index.html;
    }
}

server {
    listen 443 ssl http2;
    server_name CHANGE_ME_API_HOST;

    ssl_certificate CHANGE_ME_CERTIFICATE_FULLCHAIN;
    ssl_certificate_key CHANGE_ME_CERTIFICATE_KEY;
    client_max_body_size 8m;

    location /ws/ {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $dzdp_connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        # This reference topology is a single public nginx hop. Overwrite any
        # client-supplied forwarding chain before sending it to the backend.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_read_timeout 60s;
    }
    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
    }
}
