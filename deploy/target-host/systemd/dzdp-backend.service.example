[Unit]
Description=Dazhongdianping backend
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=dzdp
Group=dzdp
EnvironmentFile=/etc/dazhongdianping/eu-test.env
Environment=DZDP_RELEASE_ROOT=/opt/dazhongdianping
Environment=SERVER_ADDRESS=127.0.0.1
Environment=SERVER_PORT=8080
WorkingDirectory=/var/lib/dazhongdianping
ExecStart=/usr/local/libexec/dazhongdianping/run-backend.sh
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
SuccessExitStatus=143
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/dazhongdianping

[Install]
WantedBy=multi-user.target
