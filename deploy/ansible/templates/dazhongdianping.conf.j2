server {
    listen 443 ssl http2;
    server_name {{ dzdp_api_host }};

    ssl_certificate {{ dzdp_tls_certificate_path }};
    ssl_certificate_key {{ dzdp_tls_certificate_key_path }};
    client_max_body_size 8m;

    location /ws/ {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $dzdp_connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        # This reference topology is a single public nginx hop. Overwrite any
        # client-supplied forwarding chain before sending it to the backend.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_read_timeout 60s;
    }
    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
    }
}
