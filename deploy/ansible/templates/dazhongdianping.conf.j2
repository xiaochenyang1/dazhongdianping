map $http_upgrade $dzdp_connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    server_name {{ dzdp_web_host }} {{ dzdp_admin_host }} {{ dzdp_merchant_host }} {{ dzdp_api_host }};
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name {{ dzdp_web_host }};

    ssl_certificate {{ dzdp_tls_certificate_path }};
    ssl_certificate_key {{ dzdp_tls_certificate_key_path }};
    root {{ dzdp_release_root }}/current/web/dist;

    location = /health {
        default_type text/plain;
        return 200 "ok\n";
    }
    location /assets/ {
        try_files $uri =404;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }
    location / {
        try_files $uri $uri/ /index.html;
    }
}

server {
    listen 443 ssl http2;
    server_name {{ dzdp_admin_host }};

    ssl_certificate {{ dzdp_tls_certificate_path }};
    ssl_certificate_key {{ dzdp_tls_certificate_key_path }};
    root {{ dzdp_release_root }}/current/admin-web/dist;

    location = /health {
        default_type text/plain;
        return 200 "ok\n";
    }
    location /assets/ {
        try_files $uri =404;
        expires 1y;
        add_header Cache-Control "public, immutable";
