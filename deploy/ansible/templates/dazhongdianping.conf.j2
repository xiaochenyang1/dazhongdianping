    ssl_certificate_key {{ dzdp_tls_certificate_key_path }};
    root {{ dzdp_release_root }}/current/merchant-web/dist;

    location = /health {
        default_type text/plain;
        return 200 "ok\n";
    }
    location /assets/ {
        try_files $uri =404;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }
    location / {
        try_files $uri $uri/ /index.html;
    }
