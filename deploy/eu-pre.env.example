# EU pre-release environment template.
# Copy this file to a secret-managed environment file; do not commit the copy.
# Replace every CHANGE_ME value before sourcing it.

APP_RUNTIME_MODE=pre
APP_DB_HOST=CHANGE_ME
APP_DB_PORT=3306
APP_DB_NAME=dazhongdianping_eu_pre
APP_DB_USERNAME=CHANGE_ME
APP_DB_PASSWORD=CHANGE_ME

# Release workflow variables (the file itself must remain outside the release
# bundle; DEPLOY_DB_DEFAULTS_FILE points to the separate 0400/0600 client file).
DEPLOY_DB_DEFAULTS_FILE=/etc/dazhongdianping/mysql-release.cnf
DEPLOY_DB_MIGRATION_MODE=apply
# Set this only for the first takeover, to the schema version explicitly
# verified in the existing database (for a current 01_schema snapshot, 14).
# DEPLOY_DB_BASELINE_VERSION=14

APP_REDIS_HOST=CHANGE_ME
APP_REDIS_PORT=6379
APP_REDIS_PASSWORD=CHANGE_ME
APP_REDIS_DATABASE=0
APP_REDIS_HEALTH_ENABLED=true
APP_STATE_STORE_PROVIDER=redis
APP_STATE_STORE_KEY_PREFIX=dzdp:eu:pre

APP_AUTH_JWT_SECRET=CHANGE_ME_32_OR_MORE_RANDOM_BYTES
APP_PAYMENT_NOTIFY_SECRET=CHANGE_ME_32_OR_MORE_RANDOM_BYTES

# EU launch requires both email and international-phone verification. Mock
# codes and the console provider must stay disabled outside local development.
APP_AUTH_VERIFICATION_MOCK_ENABLED=false
APP_AUTH_VERIFICATION_EXPOSE_MOCK_CODE=false
APP_AUTH_VERIFICATION_DEV_CONSOLE_ENABLED=false

APP_AUTH_VERIFICATION_MAIL_ENABLED=true
APP_MAIL_HOST=CHANGE_ME
APP_MAIL_PORT=587
APP_MAIL_USERNAME=CHANGE_ME
APP_MAIL_PASSWORD=CHANGE_ME
APP_MAIL_SMTP_AUTH=true
APP_MAIL_STARTTLS_ENABLED=true
APP_MAIL_HEALTH_ENABLED=true
APP_AUTH_VERIFICATION_MAIL_FROM=no-reply@CHANGE_ME
APP_AUTH_VERIFICATION_MAIL_SUBJECT="Your verification code"
APP_AUTH_VERIFICATION_BRAND_NAME=Dazhongdianping

APP_AUTH_VERIFICATION_TWILIO_ENABLED=true
APP_AUTH_VERIFICATION_TWILIO_ACCOUNT_SID=AC_CHANGE_ME
APP_AUTH_VERIFICATION_TWILIO_AUTH_TOKEN=CHANGE_ME
# Configure either an E.164 sender number or a Messaging Service SID. The
# baseline uses a Messaging Service and leaves the direct sender empty.
APP_AUTH_VERIFICATION_TWILIO_FROM=
APP_AUTH_VERIFICATION_TWILIO_MESSAGING_SERVICE_SID=MG_CHANGE_ME
APP_AUTH_VERIFICATION_TWILIO_API_BASE_URL=https://api.twilio.com
APP_AUTH_VERIFICATION_TWILIO_ROUTE_PREFIXES=*
APP_AUTH_VERIFICATION_TWILIO_EXCLUDED_ROUTE_PREFIXES=+86

# CN phone verification is outside this EU launch gate. Enable Aliyun only
# when its CN credentials, sign, template, and +86 routing are ready.
APP_AUTH_VERIFICATION_ALIYUN_ENABLED=false
APP_AUTH_VERIFICATION_ALIYUN_ACCESS_KEY_ID=LTAI_CHANGE_ME
APP_AUTH_VERIFICATION_ALIYUN_ACCESS_KEY_SECRET=CHANGE_ME
APP_AUTH_VERIFICATION_ALIYUN_SIGN_NAME=CHANGE_ME
APP_AUTH_VERIFICATION_ALIYUN_TEMPLATE_CODE=SMS_CHANGE_ME
APP_AUTH_VERIFICATION_ALIYUN_ENDPOINT=https://dysmsapi.aliyuncs.com
APP_AUTH_VERIFICATION_ALIYUN_REGION_ID=cn-hangzhou
APP_AUTH_VERIFICATION_ALIYUN_ROUTE_PREFIXES=+86

APP_PAYMENT_STRIPE_ENABLED=true
APP_PAYMENT_STRIPE_SECRET_KEY=sk_test_CHANGE_ME
APP_PAYMENT_STRIPE_ENDPOINT_SECRET=whsec_CHANGE_ME
APP_PAYMENT_MOCK_ENABLED=false

APP_SEARCH_PROVIDER=elasticsearch
APP_SEARCH_BASE_URL=http://CHANGE_ME:9200
APP_SEARCH_INDEX_NAME=dzdp_shop_eu_v1
APP_SEARCH_FALLBACK_ON_ERROR=false

APP_FILE_STORAGE_PROVIDER=s3
APP_S3_BUCKET=CHANGE_ME
APP_S3_REGION=eu-west-1
APP_S3_ENDPOINT=https://CHANGE_ME
APP_S3_PUBLIC_BASE_URL=https://CHANGE_ME
APP_S3_ACCESS_KEY=CHANGE_ME
APP_S3_SECRET_KEY=CHANGE_ME
APP_S3_PATH_STYLE_ACCESS_ENABLED=false

# Keep mobile push disabled until FCM/APNs credentials and a real-device smoke
# test are available. The app still retains in-app notifications.
APP_PUSH_ENABLED=false

# Public Web build and SEO snapshot inputs.
APP_CORS_ALLOWED_ORIGIN_PATTERNS=https://CHANGE_ME
PUBLIC_SITE_URL=https://CHANGE_ME
PRERENDER_API_BASE_URL=https://CHANGE_ME
PRERENDER_REGION=EU

# Web build inputs. These values must also be configured as GitHub `pre`
# Environment variables so release.yml can compile them into the server bundle.
# mobile-release reuses PUBLIC_SITE_URL and VITE_STRIPE_PUBLISHABLE_KEY for
# SHARE_BASE_URL and STRIPE_PUBLISHABLE_KEY dart-defines.
VITE_API_BASE_URL=https://CHANGE_ME
VITE_WS_BASE_URL=wss://CHANGE_ME/ws
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_CHANGE_ME
