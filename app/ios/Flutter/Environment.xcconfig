// Safe local defaults. The iOS release workflow writes ignored overrides at
// build time; production identifiers and signing values must not be committed.
DZDP_IOS_BUNDLE_ID = com.example.dazhongdianpingApp
DZDP_IOS_TEAM_ID =
DZDP_APNS_ENVIRONMENT = development

DEVELOPMENT_TEAM = $(DZDP_IOS_TEAM_ID)
CODE_SIGN_STYLE = Automatic
PROVISIONING_PROFILE_SPECIFIER =
