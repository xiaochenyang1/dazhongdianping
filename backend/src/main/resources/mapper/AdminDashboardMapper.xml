<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.tuowei.dazhongdianping.module.admin.dashboard.mapper.AdminDashboardMapper">

    <sql id="shopDataScope">
        <if test="allCities == false">
            AND (
            <if test="cityIds != null and !cityIds.isEmpty()">
                s.city_id IN
                <foreach collection="cityIds" item="cityId" open="(" separator="," close=")">
                    #{cityId}
                </foreach>
            </if>
            <if test="cityIds != null and !cityIds.isEmpty() and shopIds != null and !shopIds.isEmpty()"> OR </if>
            <if test="shopIds != null and !shopIds.isEmpty()">
                s.id IN
                <foreach collection="shopIds" item="shopId" open="(" separator="," close=")">
                    #{shopId}
                </foreach>
            </if>
            <if test="(cityIds == null or cityIds.isEmpty()) and (shopIds == null or shopIds.isEmpty())">1 = 0</if>
            )
        </if>
    </sql>

    <select id="countShops" resultType="long">
        SELECT COUNT(1)
        FROM shop s
        WHERE s.region = #{region}
          AND s.is_deleted = FALSE
        <include refid="shopDataScope"/>
    </select>

    <select id="countImportBatches" resultType="long">
        SELECT COUNT(1)
        FROM import_batch
        WHERE region = #{region}
    </select>

    <select id="countPaidOrders" resultType="long">
        SELECT COUNT(1)
        FROM `order` o
        JOIN shop s ON s.id = o.shop_id AND s.region = #{region} AND s.is_deleted = FALSE
        WHERE o.region = #{region}
          AND o.pay_status = 1
        <include refid="shopDataScope"/>
    </select>

    <select id="countPendingRefunds" resultType="long">
        SELECT COUNT(1)
        FROM refund r
        JOIN `order` o ON o.id = r.order_id
        JOIN shop s ON s.id = o.shop_id AND s.region = #{region} AND s.is_deleted = FALSE
        WHERE o.region = #{region}
          AND r.status = 0
        <include refid="shopDataScope"/>
    </select>

    <select id="countPendingAuditTasks" resultType="long">
        SELECT COUNT(1)
        FROM audit_task t
        WHERE t.region = #{region}
          AND t.status = 0
        <choose>
            <when test="allowedBizTypes == null or allowedBizTypes.isEmpty()">
                AND 1 = 0
            </when>
            <otherwise>
                AND t.biz_type IN
                <foreach collection="allowedBizTypes" item="bizType" open="(" separator="," close=")">
                    #{bizType}
                </foreach>
            </otherwise>
        </choose>
    </select>

    <select id="countUsers" resultType="long">
        SELECT COUNT(1)
        FROM app_user
        WHERE status &lt;&gt; 3
    </select>
</mapper>
