# Web 前端环境变量样例。复制为 `.env.local` 后按实际填写;切勿提交真实凭证。
# cp .env.example .env.local

# API 基址。开发时若留空,前端走 vite 代理(/api → VITE_PROXY_TARGET)。
VITE_API_BASE_URL=

# WebSocket 基址(通知推送)。留空时走相对路径 /ws。
VITE_WS_BASE_URL=

# Stripe 可发布公钥(test mode)。占位符,请替换为自有 test key。
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxx

# Vite dev server 代理目标(后端地址)。
VITE_PROXY_TARGET=http://localhost:8080
